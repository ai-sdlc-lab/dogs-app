{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-paths.py",
            "args": []
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "WebFetch",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/REVIEW.md)",
      "Edit(/docs/specs/**/THREAT-*.md)",
      "Edit(/docs/specs/**/TRACE-*.md)"
    ]
  }
}
